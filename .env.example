# Copy to .env (`make env`) and fill in.
# .env is git-ignored — never commit a real token.

# GitHub token with write access to both target repositories.
#
# Fine-grained token (recommended): Repository access -> select
#   giedrius-slegeris/proto-definitions-go and
#   giedrius-slegeris/proto-definitions-php
# Permissions -> Contents: Read and write
#
# A classic token with the `repo` scope also works.
GITHUB_TOKEN=

# Author recorded on the generated commits.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Target repositories and branch.
GO_REPO=github.com/giedrius-slegeris/proto-definitions-go
PHP_REPO=github.com/giedrius-slegeris/proto-definitions-php
TARGET_BRANCH=main

# Package identifiers written into go.mod / composer.json. Keep GO_MODULE in
# sync with the `option go_package` in the .proto files.
GO_MODULE=github.com/giedrius-slegeris/proto-definitions-go
PHP_PACKAGE=giedrius-slegeris/proto-definitions-php

# Optional: override the generated commit message.
#COMMIT_MESSAGE=
